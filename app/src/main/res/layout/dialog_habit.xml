<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
 <EditText android:id="@+id/nameInput" android:hint="Alışkanlık adı" android:inputType="textCapSentences" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <TextView android:text="Hedef türü" android:textStyle="bold" android:textColor="@color/ink" android:layout_marginTop="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
 <RadioGroup android:id="@+id/typeGroup" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content"><RadioButton android:id="@+id/typeCheck" android:text="Tik" android:checked="true"/><RadioButton android:id="@+id/typeMinutes" android:text="Dakika"/><RadioButton android:id="@+id/typeReps" android:text="Tekrar"/></RadioGroup>
 <EditText android:id="@+id/targetInput" android:hint="Hedef miktarı (ör. 30)" android:inputType="number" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <Button android:id="@+id/timeButton" android:text="Bildirim saati seç" android:textAllCaps="false" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <TextView android:text="Yapılacak günler" android:textStyle="bold" android:textColor="@color/ink" android:layout_marginTop="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
 <LinearLayout android:id="@+id/weekRow" android:orientation="horizontal" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <LinearLayout android:gravity="center_vertical" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"><com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/endEnabled" android:text="Bitiş tarihi olsun" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/><EditText android:id="@+id/endDays" android:hint="Gün" android:inputType="number" android:visibility="gone" android:layout_width="70dp" android:layout_height="wrap_content"/></LinearLayout>
</LinearLayout>
